{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "songbook",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "bushcraft",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set NEXT_PUBLIC_BOOK=bushcraft&& npm run dev"
      ],
      "port": 3007,
      "autoPort": true
    },
    {
      "name": "games",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set NEXT_PUBLIC_BOOK=games&& npm run dev"
      ],
      "port": 3008,
      "autoPort": true
    }
  ]
}